{% extends "base_new.html.twig" %}

{% block title %}Connexion - SleepAdvisor{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-body p-5" style="background-color: #fff;">
                    <h2 class="card-title text-center mb-4" style="color: #d4af37; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
                        <i class="fas fa-sign-in-alt"></i> Connexion
                    </h2>

                    {% if error %}
                        <div class="alert" role="alert" style="background-color: #fef2f2; border-left: 4px solid #cc0000; color: #1a1a1a;">
                            <i class="fas fa-exclamation-circle"></i> {{ error.messageKey|trans(error.messageData) }}
                        </div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label" style="color: #1a1a1a; font-weight: 500; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;">Email</label>
                            <input type="email" class="form-control" id="email" name="email" 
                                   value="{{ last_email }}" required autofocus style="border: 1px solid #ddd; padding: 0.75rem;">
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label" style="color: #1a1a1a; font-weight: 500; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;">Mot de passe</label>
                            <input type="password" class="form-control" id="password" name="password" required style="border: 1px solid #ddd; padding: 0.75rem;">
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me" style="border: 1px solid #d4af37;">
                            <label class="form-check-label" for="remember_me" style="color: #1a1a1a;">
                                Se souvenir de moi
                            </label>
                        </div>

                        <button type="submit" class="btn w-100 mb-3" style="background-color: #d4af37; color: #000; font-weight: 500; border: none; text-transform: uppercase; letter-spacing: 0.5px; padding: 0.75rem;">
                            <i class="fas fa-sign-in-alt"></i> Se connecter
                        </button>
                    </form>

                    <hr style="border-color: #ddd;">

                    <div class="text-center">
                        <p class="mb-2">
                            <a href="{{ path('app_forgot_password') }}" class="text-decoration-none" style="color: #d4af37;">
                                Mot de passe oublié?
                            </a>
                        </p>
                        <p style="color: #666;">
                            Pas encore inscrit? 
                            <a href="{{ path('app_register') }}" class="text-decoration-none" style="color: #d4af37; font-weight: 500;">
                                S'inscrire maintenant
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
