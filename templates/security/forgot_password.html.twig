{% extends "base_new.html.twig" %}

{% block title %}Mot de passe oublié - SleepAdvisor{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-body p-5" style="background-color: #fff;">
                    <h2 class="card-title text-center mb-4" style="color: #d4af37; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
                        <i class="fas fa-key"></i> Réinitialiser votre mot de passe
                    </h2>

                    <p class="text-center mb-4" style="color: #666;">
                        Entrez votre email et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                    </p>

                    <form method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label" style="color: #1a1a1a; font-weight: 500; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;">Email</label>
                            <input type="email" class="form-control" id="email" name="email" 
                                   required autofocus placeholder="vous@exemple.com" style="border: 1px solid #ddd; padding: 0.75rem;">
                        </div>

                        <button type="submit" class="btn w-100 mb-3" style="background-color: #d4af37; color: #000; font-weight: 500; border: none; text-transform: uppercase; letter-spacing: 0.5px; padding: 0.75rem;">
                            <i class="fas fa-envelope"></i> Envoyer le lien de réinitialisation
                        </button>
                    </form>

                    <hr style="border-color: #ddd;">

                    <div class="text-center">
                        <p>
                            <a href="{{ path('app_login') }}" class="text-decoration-none" style="color: #d4af37;">
                                Retour à la connexion
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
