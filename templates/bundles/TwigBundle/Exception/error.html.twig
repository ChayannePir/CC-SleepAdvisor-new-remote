{% extends 'base_new.html.twig' %}

{% block title %}Erreur système - SleepAdvisor{% endblock %}

{% block body %}
<div class="d-flex justify-content-center align-items-center" style="min-height: 40vh;">
    <div class="text-center p-5 border rounded bg-white shadow-sm" style="max-width: 600px;">
        <h1 class="text-danger mb-4">
            <i class="fas fa-exclamation-triangle"></i> Oups ! Une erreur inattendue est survenue.
        </h1>
        <p class="lead">Pour des raisons de sécurité, notre application a interrompu le processus.</p>
        <p class="text-muted mb-4">Notre équipe technique a été automatiquement notifiée de cet incident.</p>

        <a href="{{ path('app_home') }}" class="btn" style="background-color: #d4af37; color: #000; font-weight: 500;">
            <i class="fas fa-arrow-left"></i> Retourner à la page d'accueil
        </a>
    </div>
</div>
{% endblock %}
