{% extends "admin/layout.html.twig" %}

{% block title %}Dashboard Admin - SleepAdvisor{% endblock %}

{% block admin_content %}
    {# ==================================================== #}
    {# ADMIN DASHBOARD : Page d'accueil administrateur #}
    {# Affiche les indicateurs clés, statistiques et réservations récentes #}
    {# ==================================================== #}
    <h2 class="mb-4" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
        <i class="fas fa-tachometer-alt"></i> Tableau de bord
    </h2>

    {# ==================================================== #}
    {# SECTION : KPI Principales (Réservations, Taux occupation, Clients, Parc) #}
    {# ==================================================== #}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3 mb-4">
        {# KPI 1 : Nombre total de réservations enregistrées #}
        <div class="col">
            <div class="card admin-kpi-card" style="background-color: #d4af37;">
                <div class="card-body">
                    <h6 class="text-uppercase small fw-semibold mb-1" style="color: #000;">Réservations</h6>
                    <p class="display-6 mb-0 fw-light" style="color: #000;">{{ stats.total_reservations }}</p>
                    <small style="color: #1a1a1a;">Total enregistrées</small>
                </div>
            </div>
        </div>

        {# KPI 2 : Taux d'occupation des chambres aujourd'hui #}
        <div class="col">
            <div class="card admin-kpi-card text-white" style="background-color: #000;">
                <div class="card-body">
                    <h6 class="text-uppercase small fw-semibold mb-1" style="color: #d4af37;">Taux d'occupation</h6>
                    <p class="display-6 mb-0 fw-light">{{ stats.occupancy_rate }}%</p>
                    <small class="text-secondary">{{ stats.occupied_chambres_today }} / {{ stats.total_chambres }} chambres aujourd'hui</small>
                </div>
            </div>
        </div>

        {# KPI 3 : Nombre total de clients actifs #}
        <div class="col">
            <div class="card admin-kpi-card">
                <div class="card-body">
                    <h6 class="text-uppercase small text-muted fw-semibold mb-1">Clients</h6>
                    <p class="display-6 mb-0 fw-light">{{ stats.total_clients }}</p>
                    <small class="text-muted">Comptes actifs</small>
                </div>
            </div>
        </div>

        {# KPI 4 : Parc hôtelier (nombre de chambres et hôtels) #}
        <div class="col">
            <div class="card admin-kpi-card">
                <div class="card-body">
                    <h6 class="text-uppercase small text-muted fw-semibold mb-1">Parc hôtelier</h6>
                    <p class="display-6 mb-0 fw-light">{{ stats.total_chambres }}</p>
                    <small class="text-muted">{{ stats.total_hotels }} hôtel(s)</small>
                </div>
            </div>
        </div>
    </div>

    {# ==================================================== #}
    {# SECTION : Répartition par statut (En attente / Confirmées / Annulées) #}
    {# ==================================================== #}
    <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
        {# Réservations en attente de confirmation #}
        <div class="col">
            <div class="card admin-kpi-card border-warning">
                <div class="card-body py-3">
                    <span class="badge bg-warning text-dark me-2">En attente</span>
                    <strong class="fs-4">{{ stats.reservations_en_attente }}</strong>
                </div>
            </div>
        </div>

        {# Réservations confirmées #}
        <div class="col">
            <div class="card admin-kpi-card border-success">
                <div class="card-body py-3">
                    <span class="badge bg-success me-2">Confirmées</span>
                    <strong class="fs-4">{{ stats.reservations_confirmees }}</strong>
                </div>
            </div>
        </div>

        {# Réservations annulées #}
        <div class="col">
            <div class="card admin-kpi-card border-secondary">
                <div class="card-body py-3">
                    <span class="badge bg-secondary me-2">Annulées</span>
                    <strong class="fs-4">{{ stats.reservations_annulees }}</strong>
                </div>
            </div>
        </div>
    </div>

    {# ==================================================== #}
    {# SECTION : Dernières réservations (8 récentes) #}
    {# Lien pour voir la liste complète des réservations #}
    {# ==================================================== #}
    <div class="card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 text-uppercase small fw-semibold">Dernières réservations</h5>
            <a href="{{ path('admin_reservations_list') }}" class="btn btn-sm" style="background:#d4af37;color:#000;">Voir tout</a>
        </div>
        <div class="table-responsive admin-table-desktop">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Numéro</th>
                        <th class="d-none d-md-table-cell">Client</th>
                        <th class="d-none d-lg-table-cell">Hôtel</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {# map des statuts vers les classes de badge (même palette que la légende) #}
                    {% set statusClassMap = {
                        'en attente': 'bg-warning text-dark',
                        'en attente de confirmation': 'bg-warning text-dark',
                        'confirmées': 'bg-success',
                        'confirmée': 'bg-success',
                        'confirmé': 'bg-success',
                        'confirmé(e)': 'bg-success',
                        'annulées': 'bg-secondary',
                        'annulée': 'bg-secondary'
                    } %}

                    {% for r in stats.recent_reservations %}
                        <tr>
                            <td class="fw-medium">{{ r.numeroReservation }}</td>
                            <td class="d-none d-md-table-cell">{{ r.client.nom }}</td>
                            <td class="d-none d-lg-table-cell">{{ r.hotel.nom }}</td>
                            {# Choix de la classe de badge selon le statut (fallback bg-secondary) #}
                            {% set badgeClass = statusClassMap[r.statut|lower] ?? 'bg-secondary' %}
                            <td><span class="badge {{ badgeClass }}">{{ r.statut }}</span></td>
                            <td>
                                <a href="{{ path('admin_reservation_detail', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary">Détail</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">Aucune réservation</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="admin-cards-mobile p-3">
            {% for r in stats.recent_reservations %}
                {# réutilise la même logique de couleur pour les badges mobile #}
                {% set badgeClass = statusClassMap[r.statut|lower] ?? 'bg-secondary' %}
                <div class="admin-mobile-card">
                    <strong>{{ r.numeroReservation }}</strong>
                    <div class="small text-muted">{{ r.client.nom }} — {{ r.hotel.nom }}</div>
                    <span class="badge {{ badgeClass }}">{{ r.statut }}</span>
                    <a href="{{ path('admin_reservation_detail', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary mt-2">Détail</a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
