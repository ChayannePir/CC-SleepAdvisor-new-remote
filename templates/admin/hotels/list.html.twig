{% extends "admin/layout.html.twig" %}

{% block title %}Hôtels - Admin{% endblock %}

{% block admin_content %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
                <i class="fas fa-hotel"></i> Hôtels
            </h2>
            <small class="text-muted">{{ total }} hôtel(s) au total</small>
        </div>
        <a href="{{ path('admin_hotel_create') }}" class="btn" style="background-color: #d4af37; color: #000; font-weight: 500;">
            <i class="fas fa-plus"></i> Nouvel hôtel
        </a>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-sm-6 col-lg-4">
                    <label class="form-label small text-uppercase fw-semibold">Recherche</label>
                    <input type="text" name="q" class="form-control" placeholder="Nom, adresse…" value="{{ q }}">
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <input type="hidden" name="limit" value="{{ limit }}">
                    <button type="submit" class="btn w-100" style="background:#d4af37;color:#000;"><i class="fas fa-search"></i> Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive admin-table-desktop">
        <table class="table table-hover bg-white mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th class="d-none d-sm-table-cell">Adresse</th>
                    <th class="d-none d-md-table-cell">Catégorie</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for hotel in hotels %}
                    <tr>
                        <td>{{ hotel.nom }}</td>
                        <td class="d-none d-sm-table-cell">{{ hotel.adresse }}</td>
                        <td class="d-none d-md-table-cell">{{ hotel.categorie }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('admin_hotel_edit', {id: hotel.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('admin_hotel_delete', {id: hotel.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cet hôtel ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-4">Aucun hôtel</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="admin-cards-mobile">
        {% for hotel in hotels %}
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between">
                    <strong>{{ hotel.nom }}</strong>
                    <span class="text-muted">{{ hotel.categorie }}</span>
                </div>
                <div class="small text-muted">{{ hotel.adresse }}</div>
                <div class="mt-2">
                    <a href="{{ path('admin_hotel_edit', {id: hotel.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                </div>
            </div>
        {% else %}
            <p class="text-muted text-center">Aucun hôtel</p>
        {% endfor %}
    </div>

    {% include 'admin/_pagination.html.twig' with {
        page: page,
        pages: pages,
        page_range: page_range,
        limit: limit,
        total: total,
        query_params: { q: q }
    } %}
{% endblock %}
