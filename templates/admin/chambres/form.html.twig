{% extends "admin/layout.html.twig" %}

{% block title %}{{ chambre ? 'Éditer' : 'Créer' }} une chambre - Admin{% endblock %}

{% block admin_content %}
    <h2 class="mb-4" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
        <i class="fas fa-door-open"></i> {{ chambre ? 'Éditer la chambre' : 'Créer une chambre' }}
    </h2>

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label for="hotel_id" class="form-label small text-uppercase fw-semibold">Hôtel *</label>
                            <select class="form-select" id="hotel_id" name="hotel_id" required>
                                <option value="">Sélectionner un hôtel</option>
                                {% for hotel in hotels %}
                                    <option value="{{ hotel.id }}" {% if chambre and chambre.hotel.id == hotel.id %}selected{% endif %}>
                                        {{ hotel.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="type" class="form-label small text-uppercase fw-semibold">Type *</label>
                                <select class="form-select" id="type" name="type" required>
                                    <option value="">Sélectionner</option>
                                    {% for typeOption in ['Single', 'Double', 'Twin', 'Suite', 'Deluxe'] %}
                                        <option value="{{ typeOption }}" {% if chambre and chambre.type == typeOption %}selected{% endif %}>{{ typeOption }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label for="etage" class="form-label small text-uppercase fw-semibold">Étage *</label>
                                <input type="number" class="form-control" id="etage" name="etage" value="{{ chambre ? chambre.etage : '' }}" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="nombre_lits" class="form-label small text-uppercase fw-semibold">Nombre de lits *</label>
                            <input type="number" class="form-control" id="nombre_lits" name="nombre_lits" value="{{ chambre ? chambre.nombreLits : '' }}" required min="1">
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="{{ path('admin_chambres_list') }}" class="btn btn-outline-secondary">Annuler</a>
                            <button type="submit" class="btn" style="background-color: #d4af37; color: #000;">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
