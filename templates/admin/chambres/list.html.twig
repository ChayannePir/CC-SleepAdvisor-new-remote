{% extends "admin/layout.html.twig" %}

{% block title %}Chambres - Admin{% endblock %}

{% block admin_content %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
                <i class="fas fa-door-open"></i> Chambres
            </h2>
            <small class="text-muted">{{ total }} chambre(s) au total</small>
        </div>
        <a href="{{ path('admin_chambre_create') }}" class="btn" style="background-color: #d4af37; color: #000; font-weight: 500;">
            <i class="fas fa-plus"></i> Nouvelle chambre
        </a>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small text-uppercase fw-semibold">Recherche</label>
                    <input type="text" name="q" class="form-control" placeholder="Type, hôtel, étage…" value="{{ q }}">
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small text-uppercase fw-semibold">Hôtel</label>
                    <select name="hotel_id" class="form-select">
                        <option value="">Tous</option>
                        {% for hotel in hotels %}
                            <option value="{{ hotel.id }}" {% if hotel_id == hotel.id %}selected{% endif %}>{{ hotel.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label class="form-label small text-uppercase fw-semibold">Type</label>
                    <select name="type" class="form-select">
                        <option value="">Tous</option>
                        {% for t in ['Single', 'Double', 'Twin', 'Suite', 'Deluxe'] %}
                            <option value="{{ t }}" {% if type == t %}selected{% endif %}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <input type="hidden" name="limit" value="{{ limit }}">
                    <button type="submit" class="btn w-100" style="background:#d4af37;color:#000;"><i class="fas fa-search"></i> Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive admin-table-desktop">
        <table class="table table-hover bg-white mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th class="d-none d-sm-table-cell">Étage</th>
                    <th class="d-none d-md-table-cell">Lits</th>
                    <th>Hôtel</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for chambre in chambres %}
                    <tr>
                        <td>{{ chambre.type }}</td>
                        <td class="d-none d-sm-table-cell">{{ chambre.etage }}</td>
                        <td class="d-none d-md-table-cell">{{ chambre.nombreLits }}</td>
                        <td>{{ chambre.hotel.nom }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('admin_chambre_edit', {id: chambre.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('admin_chambre_delete', {id: chambre.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette chambre ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucune chambre</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="admin-cards-mobile">
        {% for chambre in chambres %}
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between">
                    <strong>{{ chambre.type }}</strong>
                    <span class="text-muted">Ét. {{ chambre.etage }}</span>
                </div>
                <div class="small text-muted">{{ chambre.hotel.nom }} — {{ chambre.nombreLits }} lit(s)</div>
                <div class="mt-2">
                    <a href="{{ path('admin_chambre_edit', {id: chambre.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                </div>
            </div>
        {% else %}
            <p class="text-muted text-center">Aucune chambre</p>
        {% endfor %}
    </div>

    {% include 'admin/_pagination.html.twig' with {
        page: page,
        pages: pages,
        page_range: page_range,
        limit: limit,
        total: total,
        query_params: { q: q, hotel_id: hotel_id, type: type }
    } %}
{% endblock %}
