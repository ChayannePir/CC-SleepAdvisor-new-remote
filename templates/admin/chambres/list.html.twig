{% extends "base_new.html.twig" %}

{% block title %}Chambres - Admin - SleepAdvisor{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;"><i class="fas fa-door-open"></i> Gestion des chambres</h2>
        <a href="{{ path('admin_chambre_create') }}" class="btn" style="background-color: #d4af37; color: #000; border: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">
            <i class="fas fa-plus"></i> Nouvelle chambre
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0" style="background-color: #fff;">
            <thead style="background-color: #f8f8f8; border-bottom: 2px solid #d4af37;">
                <tr>
                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 1rem;">Type</th>
                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 1rem;">Étage</th>
                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 1rem;">Lits</th>
                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 1rem;">Hôtel</th>
                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 1rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for chambre in chambres %}
                    <tr>
                        <td style="padding: 1rem; color: #1a1a1a;">{{ chambre.type }}</td>
                        <td style="padding: 1rem; color: #1a1a1a;">{{ chambre.etage }}</td>
                        <td style="padding: 1rem; color: #1a1a1a;">{{ chambre.nombreLits }}</td>
                        <td style="padding: 1rem; color: #1a1a1a;">{{ chambre.hotel.nom }}</td>
                        <td style="padding: 1rem;">
                            <a href="{{ path('admin_chambre_edit', {id: chambre.id}) }}" class="btn btn-sm" style="background-color: transparent; color: #d4af37; border: 1px solid #d4af37; font-weight: 500;">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('admin_chambre_delete', {id: chambre.id}) }}" 
                                  style="display:inline;" onsubmit="return confirm('Êtes-vous sûr?');">
                                <button type="submit" class="btn btn-sm" style="background-color: #cc0000; color: #fff; border: none; font-weight: 500;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align: center; color: #999; padding: 2rem;">Aucune chambre</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pages > 1 %}
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                {% for p in 1..pages %}
                    <li class="page-item {% if p == page %}active{% endif %}">
                        <a class="page-link" href="?page={{ p }}">{{ p }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
</div>
{% endblock %}
