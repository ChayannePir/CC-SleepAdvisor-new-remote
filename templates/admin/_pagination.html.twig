{% if pages is defined and pages > 1 %}
    {% set qp = query_params|default({}) %}
    <nav class="mt-4" aria-label="Pagination">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 mb-2">
            <small class="text-muted">
                Page {{ page }} / {{ pages }}{% if total is defined %} — {{ total }} résultat(s){% endif %}
            </small>
            {% if limit is defined %}
            <form method="get" class="d-flex align-items-center gap-2">
                {% for key, value in qp %}
                    <input type="hidden" name="{{ key }}" value="{{ value }}">
                {% endfor %}
                <label for="limit-select" class="small text-muted mb-0">Par page</label>
                <select name="limit" id="limit-select" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                    {% for opt in [10, 20, 50, 100] %}
                        <option value="{{ opt }}" {% if limit == opt %}selected{% endif %}>{{ opt }}</option>
                    {% endfor %}
                </select>
            </form>
            {% endif %}
        </div>
        <ul class="pagination pagination-sm flex-wrap justify-content-center mb-0">
            {% macro link_page(p, qp, limit) %}
                ?{% for k, v in qp %}{% if v is not same as('') %}{{ k }}={{ v|url_encode }}&{% endif %}{% endfor %}page={{ p }}&limit={{ limit }}
            {% endmacro %}
            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                <a class="page-link" href="?{% for k, v in qp %}{% if v is not same as('') %}{{ k }}={{ v|url_encode }}&{% endif %}{% endfor %}page={{ page - 1 }}&limit={{ limit|default(20) }}">&laquo;</a>
            </li>
            {% if page_range[0] is defined and page_range[0] > 1 %}
                <li class="page-item"><a class="page-link" href="?{% for k, v in qp %}{% if v is not same as('') %}{{ k }}={{ v|url_encode }}&{% endif %}{% endfor %}page=1&limit={{ limit|default(20) }}">1</a></li>
                {% if page_range[0] > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for p in page_range %}
                <li class="page-item {% if p == page %}active{% endif %}">
                    <a class="page-link" href="?{% for k, v in qp %}{% if v is not same as('') %}{{ k }}={{ v|url_encode }}&{% endif %}{% endfor %}page={{ p }}&limit={{ limit|default(20) }}">{{ p }}</a>
                </li>
            {% endfor %}
            {% if page_range is defined and page_range is not empty and page_range|last < pages %}
                {% if page_range|last < pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="?{% for k, v in qp %}{% if v is not same as('') %}{{ k }}={{ v|url_encode }}&{% endif %}{% endfor %}page={{ pages }}&limit={{ limit|default(20) }}">{{ pages }}</a></li>
            {% endif %}
            <li class="page-item {% if page >= pages %}disabled{% endif %}">
                <a class="page-link" href="?{% for k, v in qp %}{% if v is not same as('') %}{{ k }}={{ v|url_encode }}&{% endif %}{% endfor %}page={{ page + 1 }}&limit={{ limit|default(20) }}">&raquo;</a>
            </li>
        </ul>
    </nav>
{% endif %}
