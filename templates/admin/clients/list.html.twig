{% extends "admin/layout.html.twig" %}

{% block title %}Clients - Admin{% endblock %}

{% block admin_content %}
    <h2 class="mb-1" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
        <i class="fas fa-users"></i> Clients
    </h2>
    <p class="text-muted mb-4">{{ total }} client(s)</p>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-8">
                    <label class="form-label small text-uppercase fw-semibold">Nom ou email</label>
                    <input type="text" name="search" class="form-control" placeholder="Rechercher…" value="{{ search }}">
                </div>
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn w-100" style="background:#d4af37;color:#000;"><i class="fas fa-search"></i> Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive admin-table-desktop">
        <table class="table table-hover bg-white mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th class="d-none d-md-table-cell">Email</th>
                    <th class="d-none d-lg-table-cell">Téléphone</th>
                    <th class="d-none d-xl-table-cell">Adresse</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                    <tr>
                        <td>{{ client.nom }}</td>
                        <td class="d-none d-md-table-cell">{{ client.email }}</td>
                        <td class="d-none d-lg-table-cell">{{ client.telephone }}</td>
                        <td class="d-none d-xl-table-cell text-truncate" style="max-width: 200px;">{{ client.adresse }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('admin_client_detail', {id: client.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-eye"></i></a>
                            <form method="post" action="{{ path('admin_client_delete', {id: client.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce client ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucun client</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="admin-cards-mobile">
        {% for client in clients %}
            <div class="admin-mobile-card">
                <strong>{{ client.nom }}</strong>
                <div class="small">{{ client.email }}</div>
                <div class="small text-muted">{{ client.telephone }}</div>
                <div class="mt-2">
                    <a href="{{ path('admin_client_detail', {id: client.id}) }}" class="btn btn-sm btn-outline-warning">Voir</a>
                </div>
            </div>
        {% endfor %}
    </div>

    {% include 'admin/_pagination.html.twig' with {
        page: page,
        pages: pages,
        page_range: page_range,
        limit: limit,
        total: total,
        query_params: { search: search }
    } %}
{% endblock %}
