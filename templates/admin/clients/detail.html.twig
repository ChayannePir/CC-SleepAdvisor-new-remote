{% extends "admin/layout.html.twig" %}

{% block title %}Client {{ client.nom }} - Admin{% endblock %}

{% block admin_content %}
    <a href="{{ path('admin_clients_list') }}" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="fas fa-arrow-left"></i> Retour
    </a>

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h3 class="h4">{{ client.nom }}</h3>
                    <hr>
                    <p class="mb-1"><strong>Email :</strong> {{ client.email }}</p>
                    <p class="mb-1"><strong>Téléphone :</strong> {{ client.telephone }}</p>
                    <p class="mb-1"><strong>Adresse :</strong> {{ client.adresse }}</p>
                    <p class="text-muted small mb-0">Inscrit le {{ client.createdAt|date('d/m/Y H:i') }}</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0 small text-uppercase fw-semibold">Réservations ({{ client.reservations|length }})</h5>
                </div>
                <div class="list-group list-group-flush">
                    {% for reservation in client.reservations %}
                        <a href="{{ path('admin_reservation_detail', {id: reservation.id}) }}" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between flex-wrap gap-1">
                                <strong>{{ reservation.numeroReservation }}</strong>
                                <span class="badge bg-secondary">{{ reservation.statut }}</span>
                            </div>
                            <small class="text-muted">{{ reservation.dateDebut|date('d/m/Y') }} — {{ reservation.dateFin|date('d/m/Y') }}</small>
                        </a>
                    {% else %}
                        <div class="list-group-item text-muted">Aucune réservation</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
