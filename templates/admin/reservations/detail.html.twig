{% extends "admin/layout.html.twig" %}

{% block title %}Réservation {{ reservation.numeroReservation }} - Admin{% endblock %}

{% block admin_content %}
    <a href="{{ path('admin_reservations_list') }}" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-2 mb-3">
                        <h3 class="mb-0">{{ reservation.numeroReservation }}</h3>
                        <span class="badge fs-6 bg-secondary">{{ reservation.statut }}</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <h6 class="text-uppercase small text-warning fw-semibold">Client</h6>
                            <p class="mb-0"><strong>{{ reservation.client.nom }}</strong></p>
                            <p class="small text-muted mb-0">{{ reservation.client.email }}</p>
                            <p class="small text-muted">{{ reservation.client.telephone }}</p>
                        </div>
                        <div class="col-12 col-md-6">
                            <h6 class="text-uppercase small text-warning fw-semibold">Hôtel</h6>
                            <p class="mb-0"><strong>{{ reservation.hotel.nom }}</strong></p>
                            <p class="small text-muted">{{ reservation.hotel.adresse }} ({{ reservation.hotel.categorie }})</p>
                        </div>
                        <div class="col-6 col-sm-4">
                            <h6 class="text-uppercase small text-muted">Arrivée</h6>
                            <p>{{ reservation.dateDebut|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-6 col-sm-4">
                            <h6 class="text-uppercase small text-muted">Départ</h6>
                            <p>{{ reservation.dateFin|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-12 col-sm-4">
                            <h6 class="text-uppercase small text-muted">Créée le</h6>
                            <p>{{ reservation.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 text-uppercase small fw-semibold">
                        <i class="fas fa-bed"></i> Chambres réservées ({{ chambres_count }})
                    </h5>
                </div>

                {% if chambres_count > 0 %}
                    <div class="table-responsive admin-table-desktop">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Type</th>
                                    <th class="d-none d-sm-table-cell">Étage</th>
                                    <th class="d-none d-md-table-cell">Lits</th>
                                    <th class="d-none d-lg-table-cell">Hôtel</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for chambre in reservation.chambres %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td><strong>{{ chambre.type }}</strong></td>
                                        <td class="d-none d-sm-table-cell">{{ chambre.etage }}</td>
                                        <td class="d-none d-md-table-cell">{{ chambre.nombreLits }}</td>
                                        <td class="d-none d-lg-table-cell">{{ chambre.hotel.nom }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="admin-cards-mobile p-3">
                        {% for chambre in reservation.chambres %}
                            <div class="admin-mobile-card">
                                <span class="badge bg-light text-dark me-1">#{{ loop.index }}</span>
                                <strong>{{ chambre.type }}</strong>
                                <div class="small text-muted">
                                    Étage {{ chambre.etage }} — {{ chambre.nombreLits }} lit(s) — {{ chambre.hotel.nom }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="card-body text-center text-muted py-4">
                        Aucune chambre associée à cette réservation.
                    </div>
                {% endif %}
            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                {% if reservation.statut == 'En attente' %}
                    <form method="post" action="{{ path('admin_reservation_confirm', {id: reservation.id}) }}">
                        <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Confirmer</button>
                    </form>
                    <form method="post" action="{{ path('admin_reservation_cancel', {id: reservation.id}) }}" onsubmit="return confirm('Annuler cette réservation ?');">
                        <button type="submit" class="btn btn-outline-danger"><i class="fas fa-times"></i> Annuler</button>
                    </form>
                {% endif %}
                {% if reservation.statut != 'Annulée' %}
                    <form method="post" action="{{ path('admin_reservation_delete', {id: reservation.id}) }}" onsubmit="return confirm('Supprimer définitivement ?');">
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Supprimer</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
