{% extends "base_new.html.twig" %}

{% block title %}Détail réservation - Admin{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <a href="{{ path('admin_reservations_list') }}" class="btn" style="background-color: transparent; color: #666; border: 1px solid #ddd; margin-bottom: 1.5rem;">
        <i class="fas fa-arrow-left"></i> Retour
    </a>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-body" style="background-color: #fff;">
                    <h3 style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">{{ reservation.numeroReservation }}</h3>
                    <span style="background-color: #d4af37; color: #000; padding: 0.4rem 0.8rem; border-radius: 4px; font-weight: 500; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        {{ reservation.statut }}
                    </span>

                    <hr style="border-color: #ddd;">

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 style="color: #d4af37; text-transform: uppercase; font-weight: 500; font-size: 0.9rem; letter-spacing: 0.5px;">Client</h6>
                            <p style="color: #1a1a1a;">
                                <strong>{{ reservation.client.nom }}</strong><br>
                                <small style="color: #666;">{{ reservation.client.email }}</small><br>
                                <small style="color: #666;">{{ reservation.client.telephone }}</small>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6 style="color: #d4af37; text-transform: uppercase; font-weight: 500; font-size: 0.9rem; letter-spacing: 0.5px;">Hôtel</h6>
                            <p style="color: #1a1a1a;"><strong>{{ reservation.hotel.nom }}</strong></p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h6 style="color: #d4af37; text-transform: uppercase; font-weight: 500; font-size: 0.9rem; letter-spacing: 0.5px;">Check-in</h6>
                            <p style="color: #1a1a1a;">{{ reservation.dateDebut|date('d/m/Y H:i') }}</p>
                        </div>

                        <div class="col-md-6">
                            <h6 style="color: #d4af37; text-transform: uppercase; font-weight: 500; font-size: 0.9rem; letter-spacing: 0.5px;">Check-out</h6>
                            <p style="color: #1a1a1a;">{{ reservation.dateFin|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-header" style="background-color: #f8f8f8; border-bottom: 2px solid #d4af37; padding: 1rem;">
                    <h5 style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500; margin: 0;">Chambres</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0" style="background-color: #fff;">
                        <thead style="border-bottom: 2px solid #d4af37;">
                            <tr>
                                <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 0.75rem;">Type</th>
                                <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 0.75rem;">Étage</th>
                                <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; padding: 0.75rem;">Lits</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for chambre in reservation.chambres %}
                                <tr>
                                    <td style="color: #1a1a1a; padding: 0.75rem;">{{ chambre.type }}</td>
                                    <td style="color: #1a1a1a; padding: 0.75rem;">{{ chambre.etage }}</td>
                                    <td style="color: #1a1a1a; padding: 0.75rem;">{{ chambre.nombreLits }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if reservation.statut == 'En attente' %}
                <div class="mt-3">
                    <form method="post" action="{{ path('admin_reservation_confirm', {id: reservation.id}) }}" style="display:inline;">
                        <button type="submit" class="btn" style="background-color: #00a86b; color: #fff; border: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="fas fa-check"></i> Confirmer
                        </button>
                    </form>

                    <form method="post" action="{{ path('admin_reservation_cancel', {id: reservation.id}) }}" style="display:inline;">
                        <button type="submit" class="btn" style="background-color: #cc0000; color: #fff; border: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;" onclick="return confirm('Êtes-vous sûr?');">
                            <i class="fas fa-times"></i> Annuler
                        </button>
                    </form>
                </div>
            {% endif %}

            {% if reservation.statut != 'Annulée' %}
                <form method="post" action="{{ path('admin_reservation_delete', {id: reservation.id}) }}" 
                      style="display:inline;" onsubmit="return confirm('Êtes-vous sûr?');">
                    <button type="submit" class="btn mt-2" style="background-color: #cc0000; color: #fff; border: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
