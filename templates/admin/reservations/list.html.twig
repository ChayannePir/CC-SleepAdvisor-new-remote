{% extends "admin/layout.html.twig" %}

{% block title %}Réservations - Admin{% endblock %}

{% block admin_content %}
    <h2 class="mb-1" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">
        <i class="fas fa-calendar"></i> Réservations
    </h2>
    <p class="text-muted mb-4">{{ total }} résultat(s)</p>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label class="form-label small text-uppercase fw-semibold">Numéro de réservation</label>
                    <input type="text" name="numero" class="form-control" placeholder="Ex. RES-…" value="{{ numero }}">
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small text-uppercase fw-semibold">Statut</label>
                    <select name="statut" class="form-select" {% if numero %}disabled{% endif %}>
                        <option value="">Tous</option>
                        {% for s in ['En attente', 'Confirmée', 'Annulée'] %}
                            <option value="{{ s }}" {% if statut == s %}selected{% endif %}>{{ s }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <button type="submit" class="btn w-100" style="background:#d4af37;color:#000;"><i class="fas fa-search"></i> Rechercher</button>
                </div>
                {% if numero %}
                    <div class="col-12">
                        <a href="{{ path('admin_reservations_list') }}" class="small">Effacer la recherche</a>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    <div class="table-responsive admin-table-desktop">
        <table class="table table-hover bg-white mb-0">
            <thead class="table-light">
                <tr>
                    <th>Numéro</th>
                    <th class="d-none d-md-table-cell">Client</th>
                    <th class="d-none d-lg-table-cell">Hôtel</th>
                    <th class="d-none d-sm-table-cell">Dates</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for reservation in reservations %}
                    <tr>
                        <td class="fw-medium">{{ reservation.numeroReservation }}</td>
                        <td class="d-none d-md-table-cell">{{ reservation.client.nom }}</td>
                        <td class="d-none d-lg-table-cell">{{ reservation.hotel.nom }}</td>
                        <td class="d-none d-sm-table-cell small">{{ reservation.dateDebut|date('d/m/Y') }} → {{ reservation.dateFin|date('d/m/Y') }}</td>
                        <td><span class="badge bg-secondary">{{ reservation.statut }}</span></td>
                        <td>
                            <a href="{{ path('admin_reservation_detail', {id: reservation.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">Aucune réservation trouvée</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="admin-cards-mobile">
        {% for reservation in reservations %}
            <div class="admin-mobile-card">
                <strong>{{ reservation.numeroReservation }}</strong>
                <div class="small">{{ reservation.client.nom }} — {{ reservation.hotel.nom }}</div>
                <div class="small text-muted">{{ reservation.dateDebut|date('d/m/Y') }} → {{ reservation.dateFin|date('d/m/Y') }}</div>
                <span class="badge bg-secondary">{{ reservation.statut }}</span>
                <a href="{{ path('admin_reservation_detail', {id: reservation.id}) }}" class="btn btn-sm btn-outline-warning mt-2">Détail</a>
            </div>
        {% endfor %}
    </div>

    {% if not numero %}
        {% include 'admin/_pagination.html.twig' with {
            page: page,
            pages: pages,
            page_range: page_range,
            limit: limit,
            total: total,
            query_params: { statut: statut }
        } %}
    {% endif %}
{% endblock %}
