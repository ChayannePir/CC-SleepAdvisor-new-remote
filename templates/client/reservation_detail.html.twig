{% extends "base_new.html.twig" %}

{% block title %}Détail réservation - SleepAdvisor{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <a href="{{ path('client_reservations') }}" class="btn" style="background-color: transparent; color: #666; border: 1px solid #ddd; margin-bottom: 1.5rem;">
        <i class="fas fa-arrow-left"></i> Retour aux réservations
    </a>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-body" style="background-color: #fff;">
                    <h3 class="card-title" style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">{{ reservation.numeroReservation }}</h3>
                    <span style="background-color: #d4af37; color: #000; padding: 0.4rem 0.8rem; border-radius: 4px; font-weight: 500; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;\">\n                        {{ reservation.statut }}\n                    </span>

                    <hr style="border-color: #ddd;\">\n
                    <div class="row">
                        <div class="col-md-6">
                            <h6 style="color: #d4af37; text-transform: uppercase; font-weight: 500; font-size: 0.9rem; letter-spacing: 0.5px;\">Hôtel</h6>
                            <p style="color: #1a1a1a;\"><strong>{{ reservation.hotel.nom }}</strong></p>
                        </div>

                        <div class="col-md-6">
                            <h6 style="color: #d4af37; text-transform: uppercase; font-weight: 500; font-size: 0.9rem; letter-spacing: 0.5px;\">Dates</h6>
                            <p style="color: #1a1a1a;\">\n                                {{ reservation.dateDebut|date('d/m/Y') }} - {{ reservation.dateFin|date('d/m/Y') }}\n                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-header" style="background-color: #f8f8f8; border-bottom: 2px solid #d4af37; padding: 1rem;\">
                    <h5 style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500; margin: 0;\">Chambres réservées</h5>
                </div>
                <div class="card-body" style="background-color: #fff;">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead style="border-bottom: 2px solid #d4af37;\">\n                                <tr>
                                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px;\">Type</th>
                                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px;\">Étage</th>
                                    <th style="color: #1a1a1a; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px;\">Lits</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for chambre in reservation.chambres %}
                                    <tr>
                                        <td style="color: #1a1a1a;\">{{ chambre.type }}</td>
                                        <td style="color: #1a1a1a;\">{{ chambre.etage }}</td>
                                        <td style="color: #1a1a1a;\">{{ chambre.nombreLits }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="card-header" style="background-color: #f8f8f8; border-bottom: 2px solid #d4af37; padding: 1rem;\">
                    <h5 style="color: #1a1a1a; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500; margin: 0;\">Demandes spéciales</h5>
                </div>
                <div class="card-body" style="background-color: #fff;">
                    {% if reservation.commentaires|length > 0 %}
                        <div class="list-group">
                            {% for commentaire in reservation.commentaires %}
                                <div class="list-group-item" style="background-color: #f8f8f8; border: 1px solid #ddd; margin-bottom: 0.5rem;\">\n                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1" style="color: #1a1a1a; font-weight: 500;\">{{ commentaire.type }}</h6>
                                        <small style="color: #999;\">{{ commentaire.createdAt|date('d/m/Y H:i') }}</small>
                                    </div>
                                    <p class="mb-1" style="color: #666;\">{{ commentaire.contenu }}</p>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p style="color: #999;\">Aucun commentaire</p>
                    {% endif %}

                    <hr style="border-color: #ddd;\">\n
                    {% if reservation.statut != 'Annulée' %}
                        <form method="post" action="{{ path('client_add_commentaire', {id: reservation.id}) }}">
                            <div class="mb-3">
                                <label for="type" class="form-label" style="color: #1a1a1a; font-weight: 500; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;\">Type de demande</label>
                                <select class="form-control" id="type" name="type" style="border: 1px solid #ddd; padding: 0.75rem;\">\n                                    <option value="Demande spéciale">Demande spéciale</option>
                                    <option value="Réclamation">Réclamation</option>
                                    <option value="Remarque">Remarque</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="contenu" class="form-label" style="color: #1a1a1a; font-weight: 500; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;\">Message *</label>
                                <textarea class="form-control" id="contenu" name="contenu" rows="3" required style="border: 1px solid #ddd; padding: 0.75rem;\"></textarea>
                            </div>

                            <button type="submit" class="btn" style="background-color: #d4af37; color: #000; font-weight: 500; border: none; text-transform: uppercase; letter-spacing: 0.5px;\">\n                                Ajouter un commentaire\n                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {% if reservation.statut != 'Annulée' %}
                <div class="mt-3">
                    <form method="post" action="{{ path('client_cancel_reservation', {id: reservation.id}) }}" \n                          onsubmit="return confirm('Êtes-vous sûr de vouloir annuler?');\">\n                        <button type="submit" class="btn" style="background-color: #cc0000; color: #fff; border: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;\">\n                            <i class=\"fas fa-times\"></i> Annuler la réservation\n                        </button>\n                    </form>\n                </div>\n            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
